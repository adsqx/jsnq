{
  "name": "@adsq/jsnq",
  "version": "0.1.4",
  "description": "Framework-agnostic JSON pipeline engine: where/update/move/copy/insert/delete over flat arrays and deeply nested trees, with copy-on-write fast paths, typed paths and a prototype-guarded path engine. Zero runtime dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsqx/jsnq.git"
  },
  "homepage": "https://github.com/adsqx/jsnq#readme",
  "bugs": "https://github.com/adsqx/jsnq/issues",
  "type": "module",
  "main": "./dist/synced/index.js",
  "types": "./dist/synced/index.d.ts",
  "typesVersions": {
    "*": {
      "core/*": [
        "dist/synced/core/*"
      ],
      "operators/*": [
        "dist/synced/operators/*"
      ],
      "data-engine": [
        "dist/data-engine.d.ts"
      ],
      "*": [
        "dist/synced/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/synced/index.d.ts",
      "import": "./dist/synced/index.js",
      "require": "./dist-cjs/synced/index.js"
    },
    "./core/actions": {
      "types": "./dist/synced/core/actions.d.ts",
      "import": "./dist/synced/core/actions.js",
      "require": "./dist-cjs/synced/core/actions.js"
    },
    "./core/compiled-mutation": {
      "types": "./dist/synced/core/compiled-mutation.d.ts",
      "import": "./dist/synced/core/compiled-mutation.js",
      "require": "./dist-cjs/synced/core/compiled-mutation.js"
    },
    "./core/compiled-predicate": {
      "types": "./dist/synced/core/compiled-predicate.d.ts",
      "import": "./dist/synced/core/compiled-predicate.js",
      "require": "./dist-cjs/synced/core/compiled-predicate.js"
    },
    "./core/data-engine": {
      "types": "./dist/synced/core/data-engine.d.ts",
      "import": "./dist/synced/core/data-engine.js",
      "require": "./dist-cjs/synced/core/data-engine.js"
    },
    "./core/flat-array-fast-path": {
      "types": "./dist/synced/core/flat-array-fast-path.d.ts",
      "import": "./dist/synced/core/flat-array-fast-path.js",
      "require": "./dist-cjs/synced/core/flat-array-fast-path.js"
    },
    "./core/match": {
      "types": "./dist/synced/core/match.d.ts",
      "import": "./dist/synced/core/match.js",
      "require": "./dist-cjs/synced/core/match.js"
    },
    "./core/operators-registry": {
      "types": "./dist/synced/core/operators-registry.d.ts",
      "import": "./dist/synced/core/operators-registry.js",
      "require": "./dist-cjs/synced/core/operators-registry.js"
    },
    "./core/ops": {
      "types": "./dist/synced/core/ops.d.ts",
      "import": "./dist/synced/core/ops.js",
      "require": "./dist-cjs/synced/core/ops.js"
    },
    "./core/pipeline-fastpath": {
      "types": "./dist/synced/core/pipeline-fastpath.d.ts",
      "import": "./dist/synced/core/pipeline-fastpath.js",
      "require": "./dist-cjs/synced/core/pipeline-fastpath.js"
    },
    "./core/pipeline-wrapper": {
      "types": "./dist/synced/core/pipeline-wrapper.d.ts",
      "import": "./dist/synced/core/pipeline-wrapper.js",
      "require": "./dist-cjs/synced/core/pipeline-wrapper.js"
    },
    "./core/pipeline": {
      "types": "./dist/synced/core/pipeline.d.ts",
      "import": "./dist/synced/core/pipeline.js",
      "require": "./dist-cjs/synced/core/pipeline.js"
    },
    "./core/types": {
      "types": "./dist/synced/core/types.d.ts",
      "import": "./dist/synced/core/types.js",
      "require": "./dist-cjs/synced/core/types.js"
    },
    "./core/utils": {
      "types": "./dist/synced/core/utils.d.ts",
      "import": "./dist/synced/core/utils.js",
      "require": "./dist-cjs/synced/core/utils.js"
    },
    "./operators/copy": {
      "types": "./dist/synced/operators/copy.d.ts",
      "import": "./dist/synced/operators/copy.js",
      "require": "./dist-cjs/synced/operators/copy.js"
    },
    "./operators/copyTo": {
      "types": "./dist/synced/operators/copyTo.d.ts",
      "import": "./dist/synced/operators/copyTo.js",
      "require": "./dist-cjs/synced/operators/copyTo.js"
    },
    "./operators/copyToAll": {
      "types": "./dist/synced/operators/copyToAll.d.ts",
      "import": "./dist/synced/operators/copyToAll.js",
      "require": "./dist-cjs/synced/operators/copyToAll.js"
    },
    "./operators/copyToFirstTarget": {
      "types": "./dist/synced/operators/copyToFirstTarget.d.ts",
      "import": "./dist/synced/operators/copyToFirstTarget.js",
      "require": "./dist-cjs/synced/operators/copyToFirstTarget.js"
    },
    "./operators/copyToMatches": {
      "types": "./dist/synced/operators/copyToMatches.d.ts",
      "import": "./dist/synced/operators/copyToMatches.js",
      "require": "./dist-cjs/synced/operators/copyToMatches.js"
    },
    "./operators/deleteElement": {
      "types": "./dist/synced/operators/deleteElement.d.ts",
      "import": "./dist/synced/operators/deleteElement.js",
      "require": "./dist-cjs/synced/operators/deleteElement.js"
    },
    "./operators/deleteKey": {
      "types": "./dist/synced/operators/deleteKey.d.ts",
      "import": "./dist/synced/operators/deleteKey.js",
      "require": "./dist-cjs/synced/operators/deleteKey.js"
    },
    "./operators/insert": {
      "types": "./dist/synced/operators/insert.d.ts",
      "import": "./dist/synced/operators/insert.js",
      "require": "./dist-cjs/synced/operators/insert.js"
    },
    "./operators/insertTo": {
      "types": "./dist/synced/operators/insertTo.d.ts",
      "import": "./dist/synced/operators/insertTo.js",
      "require": "./dist-cjs/synced/operators/insertTo.js"
    },
    "./operators/mergeUpdate": {
      "types": "./dist/synced/operators/mergeUpdate.d.ts",
      "import": "./dist/synced/operators/mergeUpdate.js",
      "require": "./dist-cjs/synced/operators/mergeUpdate.js"
    },
    "./operators/move": {
      "types": "./dist/synced/operators/move.d.ts",
      "import": "./dist/synced/operators/move.js",
      "require": "./dist-cjs/synced/operators/move.js"
    },
    "./operators/moveTo": {
      "types": "./dist/synced/operators/moveTo.d.ts",
      "import": "./dist/synced/operators/moveTo.js",
      "require": "./dist-cjs/synced/operators/moveTo.js"
    },
    "./operators/moveToAll": {
      "types": "./dist/synced/operators/moveToAll.d.ts",
      "import": "./dist/synced/operators/moveToAll.js",
      "require": "./dist-cjs/synced/operators/moveToAll.js"
    },
    "./operators/moveToFirstTarget": {
      "types": "./dist/synced/operators/moveToFirstTarget.d.ts",
      "import": "./dist/synced/operators/moveToFirstTarget.js",
      "require": "./dist-cjs/synced/operators/moveToFirstTarget.js"
    },
    "./operators/moveToMatches": {
      "types": "./dist/synced/operators/moveToMatches.d.ts",
      "import": "./dist/synced/operators/moveToMatches.js",
      "require": "./dist-cjs/synced/operators/moveToMatches.js"
    },
    "./operators/moveToMatchesOverwrite": {
      "types": "./dist/synced/operators/moveToMatchesOverwrite.d.ts",
      "import": "./dist/synced/operators/moveToMatchesOverwrite.js",
      "require": "./dist-cjs/synced/operators/moveToMatchesOverwrite.js"
    },
    "./operators/replace": {
      "types": "./dist/synced/operators/replace.d.ts",
      "import": "./dist/synced/operators/replace.js",
      "require": "./dist-cjs/synced/operators/replace.js"
    },
    "./operators/shared": {
      "types": "./dist/synced/operators/shared.d.ts",
      "import": "./dist/synced/operators/shared.js",
      "require": "./dist-cjs/synced/operators/shared.js"
    },
    "./operators/update": {
      "types": "./dist/synced/operators/update.d.ts",
      "import": "./dist/synced/operators/update.js",
      "require": "./dist-cjs/synced/operators/update.js"
    },
    "./operators/where": {
      "types": "./dist/synced/operators/where.d.ts",
      "import": "./dist/synced/operators/where.js",
      "require": "./dist-cjs/synced/operators/where.js"
    },
    "./data-engine": {
      "types": "./dist/data-engine.d.ts",
      "import": "./dist/data-engine.js",
      "require": "./dist-cjs/data-engine.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc && node scripts/fix-dist-esm-extensions.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "prepack": "npm run build && npm run verify:exports",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:types && bun run test:units && bun run test:fastpath && bun run test:data-engine && bun run test:edge && bun run test:structural && bun run test:vs-native && bun run test:proto-guard && bun run test:api && bun run test:bench",
    "test:types": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck test/types-path-contract.ts test/types-api-contract.ts",
    "test:units": "bun test/jsnq-match-actions.test.ts",
    "test:fastpath": "bun test/jsnq-fastpath-parity.test.ts",
    "test:data-engine": "bun test/jsnq-data-engine.test.ts",
    "test:edge": "bun test/jsnq-edge-cases.test.ts",
    "test:structural": "bun test/jsnq-structural-safety.test.ts",
    "test:vs-native": "bun test/jsnq-vs-native.test.ts",
    "test:bench": "bun test/jsnq-pipeline-bench.ts",
    "verify:exports": "node scripts/verify-exports.mjs",
    "test:proto-guard": "bun test/jsnq-prototype-guard.test.ts",
    "test:api": "bun test/jsnq-api-ergonomics.test.ts",
    "examples": "bun examples/index.ts",
    "examples:typecheck": "tsc --noEmit -p examples/tsconfig.json"
  },
  "keywords": [
    "json",
    "jsnq",
    "pipeline",
    "query",
    "immutable",
    "copy-on-write",
    "where",
    "update",
    "move",
    "nested",
    "json-tree",
    "path",
    "deep-update",
    "typed-paths",
    "data-engine",
    "zero-dependency",
    "framework-agnostic"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
